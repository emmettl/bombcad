{
 "source": "D. W. Murrell, Operation Prairie Flat, Project LN302: Earth Motion and Stress Measurements, Technical Report N-72-2, U.S. Army Engineer Waterways Experiment Station, February 1972, Table 3.1 (approved for public release, distribution unlimited; open copy from USACE's digital library, https://usace.contentdm.oclc.org/digital/collection/p266001coll1/id/7076). Derived numbers only.",
 "test": {
  "charge": "500 short tons of TNT, a tangent sphere on the surface, Watching Hill Blast Range, DRES (Suffield, Alberta), August 1968",
  "massKg": 453592,
  "gauges": "accelerometers (AV vertical, AH horizontal) and Sparton 601 velocity gauges (UV, UH), 84 to 1,150 ft from ground zero and 1.5 to 30 ft deep; velocities and displacements of the accelerometers are their integrals",
  "signs": "positive is upward or outward; the airblast-induced vertical peak is the downward (negative) one; horizontal negative peaks were not reported",
  "timeZero": "the detonation; arrivals in seconds; none read in the outrunning region (560 ft and beyond)"
 },
 "site": {
  "description": "lacustrine clays and silts to 200 ft; the upper 5.5 ft a tan, sandy, silty clay, then sandy silt to about 30 ft, both about 40% air by volume and highly compressible (a dynamic uniaxial strain test on the upper 5 ft: 23% vertical strain at 4,000 psi, about 2% recovered on unloading)",
  "waterTableFt": 23,
  "waterTableNote": "read off Figure 3.1 (the ground shock profile's water table, drawn at about 23 ft); not stated in the text",
  "upperLayerSpeed": 387.1,
  "saturatedSpeed": 1859.3,
  "speedNote": "propagation velocities from the earliest arrivals between 1.5 and 10 ft (upper layer) and at 30 ft (below the water table): 1,270 and 6,100 ft/s, 15% and 11% above Distant Plain 6's",
  "densityNote": "not given; the gauge canisters, about 100 pcf (1,600 kg/m3), are said to match the in-situ soil's density",
  "notGiven": "no shear speeds, layered densities or strength in this report",
  "measured": "soil-profile.json: the layers' densities and uniaxial loading and unloading stiffnesses from Jackson's Watching Hill report (WES TR S-72-4, 1972), its boring at the Prairie Flat GZ and specimens from it; no shear speeds there either"
 },
 "outrunning": {
  "rangeFt": 560,
  "note": "the wave refracted along the saturated layer overtakes the airblast at about 560 ft (35 psi); beyond it the first motions are upward and outward (Section 3.3, Figure 3.1)"
 },
