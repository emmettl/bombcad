{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/emmettl/bombcad/Benchmarks/open/schema/case.schema.json",
  "title": "Open blast benchmark case",
  "description": "One benchmark case: the scene, the charges, the gauges, the measured or reference values with their uncertainty and sources, and the scoring rule. Solver-neutral: nothing here names a code's options. Format version 1; see docs/open-benchmark.md.",
  "type": "object",
  "required": ["format", "format_version", "id", "title", "category", "summary", "reference_kind", "sources", "redistribution", "coordinates", "geometry", "runs", "scoring"],
  "additionalProperties": false,
  "properties": {
    "format": {"const": "open-blast-benchmark-case"},
    "format_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "title": {"type": "string"},
    "category": {
      "enum": ["free-field", "reflected", "shielded", "confined", "structural-response", "glazing", "ground-shock"]
    },
    "summary": {"type": "string"},
    "reference_kind": {
      "description": "measurement: values recorded in tests; empirical-fit: a curve fitted to many tests; design-curve: a design manual's chart.",
      "enum": ["measurement", "empirical-fit", "design-curve"]
    },
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "redistribution": {
      "type": "object",
      "required": ["values_included", "note"],
      "additionalProperties": false,
      "properties": {
        "values_included": {"type": "boolean"},
        "note": {"type": "string"}
      }
    },
    "coordinates": {"type": "string", "description": "Where the origin is and which way the axes run; metres, z up unless stated."},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ambient_pressure_kPa": {"type": ["number", "null"]},
        "ambient_temperature_C": {"type": ["number", "null"]},
        "note": {"type": "string"}
      }
    },
    "geometry": {
      "type": "object",
      "required": ["ground"],
      "additionalProperties": false,
      "properties": {
        "ground": {
          "type": "object",
          "required": ["kind", "description"],
          "additionalProperties": false,
          "properties": {
            "kind": {"enum": ["rigid-plane", "soil", "none", "not-stated"]},
            "z_m": {"type": "number"},
            "description": {"type": "string"},
            "properties": {"type": "object"}
          }
        },
        "obstacles": {"type": "array", "items": {"$ref": "#/$defs/obstacle"}},
        "structure": {"$ref": "#/$defs/structure"},
        "note": {"type": "string"}
      }
    },
    "runs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/run"}},
    "scoring": {
      "type": "object",
      "required": ["rule", "factor", "note"],
      "additionalProperties": false,
      "properties": {
        "rule": {"const": "within-factor"},
        "factor": {"type": "number", "exclusiveMinimum": 1},
        "factor_by_quantity": {
          "type": "object",
          "additionalProperties": {"type": "number", "exclusiveMinimum": 1}
        },
        "note": {"type": "string"}
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transcribed_from": {"type": "array", "items": {"type": "string"}},
        "transcribed": {"type": "string"},
        "note": {"type": "string"}
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["id", "authors", "year", "title", "venue", "licence", "redistribution"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "authors": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "year": {"type": "integer"},
        "title": {"type": "string"},
        "venue": {"type": "string"},
        "doi": {"type": "string"},
        "url": {"type": "string"},
        "identifier": {"type": "string"},
        "licence": {"type": "string"},
        "redistribution": {"enum": ["values-included", "cited-only"]},
        "used_for": {"type": "string"},
        "note": {"type": "string"}
      },
      "anyOf": [{"required": ["doi"]}, {"required": ["url"]}, {"required": ["identifier"]}]
    },
    "obstacle": {
      "type": "object",
      "required": ["id", "shape", "behaviour", "description"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "shape": {"enum": ["box"]},
        "min_m": {"$ref": "#/$defs/point"},
        "max_m": {"$ref": "#/$defs/point"},
        "behaviour": {"enum": ["rigid", "deformable"]},
        "material": {"type": "string"},
        "description": {"type": "string"}
      }
    },
    "structure": {
      "type": "object",
      "required": ["kind", "description"],
      "properties": {
        "kind": {"type": "string"},
        "description": {"type": "string"}
      }
    },
    "charge": {
      "type": "object",
      "required": ["explosive", "mass_kg", "tnt_equivalence", "tnt_equivalent_mass_kg", "shape", "centre_m"],
      "additionalProperties": false,
      "properties": {
        "explosive": {"type": "string"},
        "mass_kg": {"type": "number", "exclusiveMinimum": 0},
        "tnt_equivalence": {
          "type": "object",
          "required": ["factor", "basis"],
          "additionalProperties": false,
          "properties": {
            "factor": {"type": "number", "exclusiveMinimum": 0},
            "basis": {"type": "string"},
            "source": {"type": "string"}
          }
        },
        "tnt_equivalent_mass_kg": {"type": "number", "exclusiveMinimum": 0},
        "shape": {"type": "string"},
        "centre_m": {"$ref": "#/$defs/point"},
        "height_of_burst_m": {"type": ["number", "null"]},
        "initiation": {"type": "string"},
        "note": {"type": "string"}
      }
    },
    "load": {
      "type": "object",
      "required": ["kind", "applied_to", "description"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["friedlander"]},
        "applied_to": {"type": "string"},
        "peak_kPa": {"type": "number"},
        "duration_ms": {"type": "number"},
        "decay_b": {"type": "number"},
        "description": {"type": "string"}
      }
    },
    "run": {
      "type": "object",
      "required": ["id", "description", "gauges"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "description": {"type": "string"},
        "charges": {"type": "array", "items": {"$ref": "#/$defs/charge"}},
        "load": {"$ref": "#/$defs/load"},
        "obstacles": {"type": "array", "items": {"$ref": "#/$defs/obstacle"}},
        "structure": {"type": "object"},
        "gauges": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/gauge"}}
      },
      "anyOf": [{"required": ["charges"]}, {"required": ["load"]}]
    },
    "gauge": {
      "type": "object",
      "required": ["id", "mount", "measured"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "position_m": {"oneOf": [{"$ref": "#/$defs/point"}, {"type": "null"}]},
        "mount": {"enum": ["ground-flush", "face-flush", "column-face", "free-air", "on-structure", "buried", "room-average"]},
        "on": {"type": "string"},
        "description": {"type": "string"},
        "measured": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/measured"}}
      }
    },
    "measured": {
      "type": "object",
      "required": ["quantity", "unit", "source"],
      "additionalProperties": false,
      "properties": {
        "quantity": {"$ref": "#/$defs/quantity"},
        "unit": {"$ref": "#/$defs/unit"},
        "value": {"type": ["number", "boolean"]},
        "range": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
        "withheld": {"type": "boolean"},
        "uncertainty": {"$ref": "#/$defs/uncertainty"},
        "source": {"type": "string", "description": "A source id from the case's sources, with the table, figure or page."},
        "note": {"type": "string"}
      },
      "oneOf": [{"required": ["value"]}, {"required": ["range"]}, {"required": ["withheld"]}]
    },
    "uncertainty": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["sd", "half-width", "reading"]},
        "value": {"type": "number", "minimum": 0},
        "relative": {"type": "number", "minimum": 0},
        "note": {"type": "string"}
      },
      "oneOf": [{"required": ["value"]}, {"required": ["relative"]}]
    },
    "quantity": {
      "enum": [
        "peak_incident_overpressure",
        "incident_positive_impulse",
        "arrival_time",
        "peak_reflected_overpressure",
        "reflected_positive_impulse",
        "quasi_static_gas_pressure",
        "peak_displacement",
        "residual_displacement",
        "cracked",
        "peak_acceleration_vertical",
        "peak_particle_velocity_vertical",
        "peak_particle_speed_horizontal"
      ]
    },
    "unit": {"enum": ["kPa", "kPa*ms", "ms", "mm", "m/s", "m/s^2", "boolean"]},
    "point": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3}
  }
}
