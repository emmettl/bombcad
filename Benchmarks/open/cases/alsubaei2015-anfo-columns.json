  "category": "free-field",
  "summary": "Field shots of 2.4 to 15 kg of ANFO, 0.5 m up over a rigid slab, with no wall: the peak pressure recorded by gauges facing the charge on narrow steel pipe columns 8.2 to 12.85 m away, four gauges up each from 0.75 to 5.25 m. A real explosive with a stated TNT equivalence, and the gauges' own scatter.",
  "reference_kind": "measurement",
  "sources": [
    {
      "id": "alsubaei-2015",
      "authors": [
        "F. C. F. Alsubaei"
      ],
      "year": 2015,
      "title": "Performance of protective perimeter walls subjected to explosions in reducing the blast resultants on buildings",
      "venue": "Master's thesis, Western University",
      "url": "https://hdl.handle.net/20.500.14721/35930",
      "licence": "No terms stated by the repository",
      "redistribution": "values-included",
      "used_for": "Tables 4.3-4.5, 4.9-4.11 (chapters 4 and 5) and 6.3-6.10 (chapter 6): peak pressures on the columns with no wall",
      "note": "Only numbers are transcribed (measured facts), from the thesis's tables; no text or figures are copied."
    }
  ],
  "redistribution": {
    "values_included": true,
    "note": "Measured peaks transcribed from the thesis's tables, cited; the repository states no terms, so nothing else is taken."
  },
  "coordinates": "Origin on the ground below the charge; x towards the columns, z up; metres.",
  "geometry": {
    "ground": {
      "kind": "rigid-plane",
      "z_m": 0,
      "description": "A reinforced concrete slab in front of the wall's position, a 20 mm steel plate under the charge; the thesis calls it fully reflective."
    },
    "structure": {
      "kind": "pipe columns",
      "description": "Galvanised steel pipe columns 6 m tall on concrete foundations, standing for a building ('non-responding'). Their diameter, and whether they stand in one line, are not stated. With no wall, nothing else stood between charge and columns."
    }
  },
