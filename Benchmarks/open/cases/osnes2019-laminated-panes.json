  "id": "osnes2019-laminated-panes",
  "title": "Osnes et al. 2019: laminated panes in a shock tube, cracked or held",
  "category": "glazing",
  "summary": "Fifteen laminated panes (3.8 mm annealed glass, 1.52 mm PVB, 3.8 mm annealed glass) clamped over 0.3 x 0.3 m in SIMLab's shock tube under fitted Friedlander pulses of 168 to 259 kPa: whether both plies cracked, and how far the centre went. Eight held and seven cracked, C-01 holding and C-02 cracking on nearly the same load. No air is needed: the load is given.",
  "reference_kind": "measurement",
  "sources": [
    {
      "id": "osnes-2019",
      "authors": [
        "K. Osnes",
        "J. K. Holmen",
        "O. S. Hopperstad",
        "T. Børvik"
      ],
      "year": 2019,
      "title": "Fracture and fragmentation of blast-loaded laminated glass",
      "venue": "International Journal of Impact Engineering 132 (2019) 103334",
      "identifier": "IJIE 132 (2019) 103334",
      "licence": "CC BY 4.0",
      "redistribution": "values-included",
      "used_for": "Table 2: each shot's Friedlander fit of the reflected pressure, whether both plies cracked, and the largest deflection"
    }
  ],
  "redistribution": {
    "values_included": true,
    "note": "Transcribed from an open-access paper (CC BY 4.0), with citation."
  },
